# .env.example —— 环境变量示例（复制为 .env 后填写；.env 绝不入库）
# 说明：秘密只进 .env/进程外注入，config.ts 读取时不写入 process.env（借鉴 nanoclaw src/env.ts 设计）
# 修改记录：
#   2026-08-12 创建（阶段 0）
#   2026-08-13 阶段 14：增补 OC_LOCALE（i18n）
#   2026-10-06 T1-1/T1-4/P2-2：补 OC_LLM_PROXY_HOST/PORT/TRUSTED_CIDRS 与 OC_CONTAINER_BIN；
#              EGRESS_NETWORK 示例值由 openclaw-egress 改为 oc-egress（与 config.ts 默认一致）；
#              补 WEB_HOST/WEB_TOKEN 说明

# ---- 基础 ----
APP_ENV=dev                      # dev/test/prod
LOG_LEVEL=info                   # debug/info/warn/error
TZ=Asia/Shanghai                 # 安装时区（IANA），存储 ISO-UTC、显示本地化
OC_LOCALE=en                     # 宿主侧 i18n 语言：zh / en / ja（CLI、Web API、渠道文案）

# ---- LLM Provider（密钥永不进容器 env，经网关注入；此处仅供主机侧直连调试） ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=                 # OpenAI 兼容端点（DeepSeek/GLM/Qwen/Moonshot 等）
OLLAMA_HOST=                     # 本地 Ollama，如 http://127.0.0.1:11434
DEFAULT_AGENT_PROVIDER=claude    # claude / openai / ollama

# ---- LLM 密钥代理（容器经此访问上游，真实密钥由主机在边界注入，永不进容器） ----
# 默认 127.0.0.1:8081。Docker Desktop（Win/Mac）下容器经 host.docker.internal 到达宿主回环，
# 默认值即可用；原生 Linux Docker 需把 HOST 设为 docker0 网关（如 172.17.0.1）。
# 端口冲突时改 PORT 即可，容器会自动被告知新端口（8081 常被 Docker Desktop 自身占用）。
OC_LLM_PROXY_HOST=127.0.0.1
OC_LLM_PROXY_PORT=8081
OC_LLM_PROXY_TRUSTED_CIDRS=127.0.0.0/8,172.17.0.0/16,192.168.65.0/24

# ---- 容器资源限制 ----
CONTAINER_CPU_LIMIT=1
CONTAINER_MEMORY_LIMIT=1g
CONTAINER_PIDS_LIMIT=100

# ---- 容器运行时 ----
OC_CONTAINER_BIN=docker            # docker / podman（白名单外一律回落 docker）

# ---- 出口网络隔离（可选） ----
EGRESS_LOCKDOWN=false
EGRESS_NETWORK=oc-egress           # 与 config.ts 默认值一致

# ---- Web 管理控制台 ----
WEB_PORT=8080
WEB_HOST=127.0.0.1                 # 容器化部署需改 0.0.0.0，并同时设置 WEB_TOKEN
WEB_TOKEN=                         # 留空 = 仅回环可达；设置后恒要求 Bearer

# ---- 可选：RAG 模块 PostgreSQL+pgvector 后端（默认 sqlite-vec，无需此项） ----
RAG_VECTOR_BACKEND=sqlite        # sqlite / pgvector
DATABASE_URL=                    # 仅 pgvector 后端需要，如 postgresql://user:pass@host:5432/oc_kb
