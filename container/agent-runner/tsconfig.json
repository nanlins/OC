// tsconfig.json —— Agent Runner（容器侧，Bun 运行时）独立 TS 配置
// 说明：与主机 tsconfig 分离（借鉴 nanoclaw 双运行时纪律：主机 Node+pnpm，容器 Bun）。
//       bun:sqlite 命名参数需带 $ 前缀；测试用 bun:test 而非 vitest。
// 修改记录：
//   2026-08-12 创建（阶段 0）
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["src/**/*.ts"]
}
